#Ambiente de execução 
APP_ENV=development

# Banco de teste local iniciado pelo Docker Compose. A porta 5434 evita conflito com
# a instância de teste anterior na porta 5433.
POSTGRES_USER=brasilhub
POSTGRES_DB=brasilhub
POSTGRES_PASSWORD=Teste123

# URL para comandos Python executados fora do Docker.
DATABASE_URL=postgresql://brasilhub:Teste123@127.0.0.1:5434/brasilhub

# URL do banco PostgreSQL usado pelos testes (a fixture cria um schema temporário).
TEST_DATABASE_URL=postgresql://brasilhub:Teste123@127.0.0.1:5434/brasilhub

#Endereço base dos serviços de dados da API
IBGE_API_URL= https://servicodados.ibge.gov.br/api/v2/censos/nomes/

# Cada integrante copia .env.example para .env e ajusta as configurações locais.

# Conta administrativa inicial, usada por: python -m scripts.seed_admin
# Defina valores reais apenas no seu .env (que não vai para o Git)
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
